{
  "manifest_version": 3,
  "name": "Sokker++",
  "version": "0.2.2",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "host_permissions": [
    "https://sokker.org/*",
    "https://*.sokker.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sokker.org/*",
        "https://*.sokker.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Sokker++",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "type": "module",
    "service_worker": "background.js"
  }
}
