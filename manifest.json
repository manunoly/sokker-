{
  "manifest_version": 3,
  "name": "Sokker++",
  "version": "0.2.0",
  "description": "Track Sokker player skill changes, training history, and estimated talent in your browser.",
  "host_permissions": [
    "https://sokker.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sokker.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Sokker++",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}